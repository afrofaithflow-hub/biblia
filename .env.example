# Obtenha estas credenciais no painel do seu projeto Supabase:
# https://supabase.com/dashboard/project/_/settings/api

VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=seu-anon-key-aqui
VITE_ASSISTANT_FUNCTION_NAME=theological-assistant

# IMPORTANTE: este ficheiro é carregado pelo browser. Nunca adicione chaves de
# Gemini, OpenAI, service role ou qualquer segredo de IA com prefixo VITE_.
# Configure-os exclusivamente nos segredos da Edge Function:
# AI_PROVIDER=gemini ou openai
# GEMINI_API_KEY=... ou OPENAI_API_KEY=...
# AI_ALLOWED_ORIGINS=https://o-dominio-de-producao
